      ],
      "flags": {},
      "order": 0,
      "mode": 0,
      "inputs": [],
      "outputs": [],
      "properties": {
        "Node name for S&R": "Note"
      },
      "widgets_values": [
        "LoRA reference loop\n\n1. Load Prompt List: click \"upload yaml\" and pick custom_nodes/personal-utils/lora_dataset_prompts.yaml.\n2. Reference Picker: click \"Upload photos\" and pick your reference photos, they go to input/<Reference Analyzer's folder>.\n3. Click \"Analyze\" on the Reference Picker. It runs only the Reference Analyzer, which stays muted so Run never analyzes again.\n4. Open \"Anchors\", click 3-5 photos that clearly show the subject alone, then Analyze again. The subject is found in every other photo by face, other people count against a photo.\n5. Go through the prompts and click photos to pick or unpick them, Muse uses the first 7 picks of each prompt. Hover a photo for its score breakdown, \"Weights\" changes how much each part counts.\n6. Run. Meta Muse Image Edit gets the prompt, its aspect ratio and the picked photos, and each result is saved to output/lora_dataset as <id>_0001.png. This is a paid API node (about $0.014 per image, 48 per run) and needs a Comfy account sign-in.\n7. Untick prompts in the picker's list to leave them out. Run only makes the ticked prompts with no image in output/lora_dataset yet (Pending Prompts).\n8. Open \"Results\" to approve or reject the images. Rejected ones move to output/lora_dataset/rejected and are made again on the next Run.\n\nWeb and image search are off on the Muse node so it can't pull in photos of other people, turn them on there if you want them.\n\nCaptions are in the YAML (\"caption\"), replace TRIGGER and [HAIR COLOR] before training."
      ],
      "widgets_values_named": {
        "text": "LoRA reference loop\n\n1. Load Prompt List: click \"upload yaml\" and pick custom_nodes/personal-utils/lora_dataset_prompts.yaml.\n2. Reference Picker: click \"Upload photos\" and pick your reference photos, they go to input/<Reference Analyzer's folder>.\n3. Click \"Analyze\" on the Reference Picker. It runs only the Reference Analyzer, the loop doesn't start.\n4. Open \"Anchors\", click 3-5 photos that clearly show the subject alone, then Analyze again. The subject is found in every other photo by face, other people count against a photo.\n5. Go through the prompts and click photos to pick or unpick them. Hover a photo for its score breakdown, \"Weights\" changes how much each part counts.\n6. Run. Meta Muse Image Edit gets the prompt, its aspect ratio and the picked photos, and each result is saved to output/lora_dataset as <id>_0001.png. This is a paid API node (about $0.014 per image, 48 per run) and needs a Comfy account sign-in.\n\nWeb and image search are off on the Muse node so it can't pull in photos of other people, turn them on there if you want them.\n\nCaptions are in the YAML (\"caption\"), replace TRIGGER and [HAIR COLOR] before training."
      },
      "color": "#432",
      "bgcolor": "#653"
    },
